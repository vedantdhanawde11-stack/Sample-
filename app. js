:root {
  --wa-green: #075E54;
  --wa-light-green: #128C7E;
  --wa-teal: #25D366;
  --wa-chat-bg: #EFEAE2;
  --wa-bubble-me: #E7FFDB;
  --wa-bubble-them: #FFFFFF;
  --wa-dark-header: #202C33;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

body {
  background-color: #D1D7DB;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.hidden { display: none !important; }

/* AUTH SCREEN */
.auth-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #111B21;
}

.auth-box {
  background: #222E35;
  padding: 35px 30px;
  border-radius: 12px;
  width: 90%;
  max-width: 380px;
  color: #E9EDEF;
  text-align: center;
}

.auth-box h2 { margin: 15px 0 5px; }
.auth-box p { color: #8696A0; font-size: 14px; margin-bottom: 25px; }

.auth-box input {
  width: 100%;
  padding: 12px 14px;
  margin-bottom: 15px;
  border-radius: 8px;
  border: 1px solid #3b4a54;
  background: #2A3942;
  color: #fff;
  font-size: 15px;
  outline: none;
}

.auth-box button {
  width: 100%;
  padding: 12px;
  background: #00A884;
  color: #fff;
  font-weight: 600;
  border: none;
  border-radius: 8px;
  cursor: pointer;
}

.error-msg {
  color: #F15C6D;
  font-size: 13px;
  margin-top: 12px;
}

/* APP LAYOUT */
.app-layout {
  width: 100%;
  max-width: 850px;
  height: 100vh;
  background: var(--wa-chat-bg);
  display: flex;
  flex-direction: column;
  box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}

@media (min-width: 851px) {
  .app-layout {
    height: 94vh;
    border-radius: 10px;
    overflow: hidden;
  }
}

/* HEADER */
.app-header {
  background: var(--wa-green);
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  z-index: 10;
}

.user-info { display: flex; align-items: center; gap: 10px; }
.avatar {
  background: #25D366;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
}
.username { font-weight: 600; font-size: 16px; }

.header-tabs { display: flex; gap: 8px; }
.tab-btn {
  background: transparent;
  border: none;
  color: #D1E5E1;
  padding: 6px 12px;
  border-radius: 20px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 14px;
}
.tab-btn.active {
  background: rgba(255, 255, 255, 0.2);
  color: #FFF;
  font-weight: 600;
}

.icon-btn {
  background: none;
  border: none;
  color: #FFF;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* CHAT TAB */
.tab-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-area {
  flex: 1;
  padding: 16px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
  background-image: radial-gradient(#d3cbbe 1px, transparent 1px);
  background-size: 20px 20px;
}

.bubble {
  max-width: 70%;
  padding: 8px 12px;
  border-radius: 8px;
  font-size: 14.5px;
  line-height: 1.4;
  position: relative;
  word-break: break-word;
  box-shadow: 0 1px 1.5px rgba(0,0,0,0.13);
}

.bubble.me {
  align-self: flex-end;
  background-color: var(--wa-bubble-me);
  border-top-right-radius: 2px;
}

.bubble.them {
  align-self: flex-start;
  background-color: var(--wa-bubble-them);
  border-top-left-radius: 2px;
}

.bubble .meta {
  font-size: 10px;
  color: #667781;
  float: right;
  margin-top: 4px;
  margin-left: 8px;
}

.bubble img {
  max-width: 100%;
  border-radius: 6px;
  margin-bottom: 4px;
  display: block;
}

.pdf-link {
  display: flex;
  align-items: center;
  gap: 6px;
  text-decoration: none;
  color: #007DFC;
  font-weight: 500;
}

/* CHAT INPUT */
.chat-input-bar {
  background: #F0F2F5;
  padding: 8px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.chat-input-bar .icon-btn { color: #54656F; }

.chat-input-bar input[type="text"] {
  flex: 1;
  padding: 10px 14px;
  border: none;
  border-radius: 20px;
  background: #FFF;
  outline: none;
  font-size: 15px;
}

.send-btn {
  background: #00A884 !important;
  color: #FFF !important;
  border-radius: 50%;
  width: 38px;
  height: 38px;
}

/* STATUS TAB */
#status-tab, #vault-tab {
  background: #FFF;
  padding: 16px;
  overflow-y: auto;
}

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.status-header h3 { font-size: 18px; color: #111B21; }
.status-header p { font-size: 13px; color: #667781; }

.status-upload-btn {
  background: #00A884;
  color: #FFF;
  padding: 8px 14px;
  border-radius: 20px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13.5px;
  font-weight: 500;
}

.stories-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 16px;
}

.story-card {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  height: 250px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  background: #000;
}

.story-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.story-overlay {
  position: absolute;
  bottom: 0;
  width: 100%;
  background: linear-gradient(transparent, rgba(0,0,0,0.8));
  color: #FFF;
  padding: 8px;
  font-size: 12px;
}

/* VAULT TAB */
.vault-tools {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 20px;
}

.vault-note-box textarea {
  width: 100%;
  height: 70px;
  padding: 10px;
  border-radius: 8px;
  border: 1px solid #E0E0E0;
  resize: none;
  font-size: 14px;
  outline: none;
}

.vault-note-box button {
  background: #128C7E;
  color: #FFF;
  border: none;
  padding: 8px 16px;
  border-radius: 6px;
  cursor: pointer;
  margin-top: 6px;
  font-weight: 500;
}

.vault-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.vault-item {
  background: #F8F9FA;
  border: 1px solid #E9EDEF;
  border-radius: 8px;
  padding: 12px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}